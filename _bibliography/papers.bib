@inproceedings{patibanda_actuating_2021,
	address = {New York, NY, USA},
	series = {{CHI} {PLAY} '21},
	title = {Actuating {Myself}: {Designing} {Hand}-{Games} {Incorporating} {Electrical} {Muscle} {Stimulation}},
